# This config file is a weird combination of the one auto-generated by the i3-config-wizard
# and the one made by github user "SkyyySi". 
# Link to that config file: https://github.com/SkyyySi/dots-nordic/blob/master/Configurations/i3/config


#####################
#     VARIABLES 
#####################

# key bind variables
set $mod Mod4
set $smod Shift
floating_modifier $mod
set $numpad_off_1 KP_End
set $numpad_off_2 KP_Down
set $numpad_off_3 KP_Next
set $numpad_off_4 KP_Left
set $numpad_off_5 KP_Begin
set $numpad_off_6 KP_Right
set $numpad_off_7 KP_Home
set $numpad_off_8 KP_Up
set $numpad_off_9 KP_Prior
set $numpad_off_0 KP_Insert

# COLORS
set $wm_color_border_active_bg       #950101
set $wm_color_border_active_fg       #950101
set $wm_color_border_inactive_bg     #3D0000
set $wm_color_border_inactive_fg     #3D0000
set $wm_color_background             #3D0000

# default terminal command
set $terminal xfce4-terminal

# default application finder command
set $rofi "rofi -modi drun,run -show drun -show-icons"

# fonts
set $wm_font pango: FiraMono Nerd Font 0
font $wm_font


#####################
#     COMMANDS 
#####################

# start a terminal
bindsym $mod+Return exec $terminal

# kill focused window
bindsym $mod+$smod+q kill

# start rofi
bindsym $mod+d exec $rofi

# switch focus using cursor keys
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused tile, you can use smod + the cursor keys:
bindsym $mod+$smod+Left move left
bindsym $mod+$smod+Down move down
bindsym $mod+$smod+Up move up
bindsym $mod+$smod+Right move right

# split in horizontal orientation
bindsym $mod+h split h

# split in vertical orientation
bindsym $mod+v split v

# switch to resizing mode
bindsym $mod+r mode "resize"
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+$smod+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# reload the configuration file
bindsym $mod+$smod+c reload

# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+$smod+r restart

# exit i3 (logs you out of your X session)
bindsym $mod+$smod+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1/󰈹 Main "
set $ws2 "2/ Dev "
set $ws3 "3/  GameDev "
set $ws4 "4/ Terms "
set $ws5 "5/ Files "
set $ws6 "6/ Discord "
set $ws7 "7/ Games "
set $ws8 "8/ Any1 "
set $ws9 "9/ Any2 "
set $ws10 "10/󰝚 Tunes "

# switch to workspaces using numpad (numlock off)
bindsym $mod+$numpad_off_1 workspace $ws1
bindsym $mod+$numpad_off_2 workspace $ws2
bindsym $mod+$numpad_off_3 workspace $ws3
bindsym $mod+$numpad_off_4 workspace $ws4
bindsym $mod+$numpad_off_5 workspace $ws5
bindsym $mod+$numpad_off_6 workspace $ws6
bindsym $mod+$numpad_off_7 workspace $ws7
bindsym $mod+$numpad_off_8 workspace $ws8
bindsym $mod+$numpad_off_9 workspace $ws9
bindsym $mod+$numpad_off_0 workspace $ws10

# move focused container to workspace using numpad (numlock off)
bindsym $mod+$smod+$numpad_off_1 move container to workspace $ws1
bindsym $mod+$smod+$numpad_off_2 move container to workspace $ws2
bindsym $mod+$smod+$numpad_off_3 move container to workspace $ws3
bindsym $mod+$smod+$numpad_off_4 move container to workspace $ws4
bindsym $mod+$smod+$numpad_off_5 move container to workspace $ws5
bindsym $mod+$smod+$numpad_off_6 move container to workspace $ws6
bindsym $mod+$smod+$numpad_off_7 move container to workspace $ws7
bindsym $mod+$smod+$numpad_off_8 move container to workspace $ws8
bindsym $mod+$smod+$numpad_off_9 move container to workspace $ws9
bindsym $mod+$smod+$numpad_off_0 move container to workspace $ws10

#####################
#    APPLICATION
#      ORDERS 
#####################

# Force certain applications to load on certain workspaces
assign [class="firefox"] $ws1
assign [class="librewolf"] $ws1
assign [class="Google-chrome"] $ws1

assign [class="Code"] $ws2

assign [class="Godot"] $ws3
assign [class="Unityhub"] $ws3

assign [class="Xfce4-terminal"] $ws4

assign [class="Thunar"] $ws5

assign [class="discord"] $ws6

assign [class="Steam"] $ws7
assign [class="hl2_linux"] $ws7   # TF2 and other Source engine games
assign [class="minecraft-launcher"] $ws7

assign [class="Rhythmbox"] $ws10


#####################
#    APPEARANCE
#####################
# gaps
gaps inner 4
gaps outer 2

default_border pixel 1

# class                 border                       background                   text                         indicator                    child_border
client.focused          $wm_color_border_active_bg   $wm_color_border_active_bg   $wm_color_border_active_fg   $wm_color_border_active_bg   $wm_color_border_active_bg
client.focused_inactive $wm_color_border_inactive_bg $wm_color_border_inactive_bg $wm_color_border_inactive_fg $wm_color_border_inactive_bg $wm_color_border_inactive_bg
client.unfocused        $wm_color_border_inactive_bg $wm_color_border_inactive_bg $wm_color_border_inactive_fg $wm_color_border_inactive_bg $wm_color_border_inactive_bg
client.urgent           $wm_color_border_inactive_bg $wm_color_border_inactive_bg $wm_color_border_inactive_fg $wm_color_border_inactive_bg $wm_color_border_inactive_bg
client.placeholder      $wm_color_border_inactive_bg $wm_color_border_inactive_bg $wm_color_border_inactive_fg $wm_color_border_inactive_bg $wm_color_border_inactive_bg
client.background       $wm_color_background


#####################
#    ON-STARTUP 
#####################
# picom 
exec --no-startup-id picom
# background
exec_always nitrogen --restore
# polybar
exec_always killall -q polybar; polybar

