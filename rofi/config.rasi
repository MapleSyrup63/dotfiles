* {
  normal-background: #00000099;
  normal-foreground: #FFFFFFbb;
  alternate-normal-background: #00000099;
  alternate-normal-foreground: #FFFFFFbb;
  selected-normal-background: #950101;
  selected-foreground: #FFFFFF;
}


window {
  padding: 1em;

  border-color: #950101;
  border:       2px;

  width:  1024px; 
  height: 768px;

  background-color: #000000;
}

mainbox {
  spacing: 0px;
  children: [inputbar,wrapper-mode-switcher,listview];
}

element {
  children: [ element-icon, element-text ];
}
element,element-text,element-icon, button {
    cursor: pointer;
}

inputbar {
  margin: 0px 0px 0.5em 0em;
  spacing: 0.4em;
  children: [ button-mapleleaf, entry,overlay,case-indicator, button-mapleleaf];
}

button-mapleleaf {
  expand: false;
  content: " 🍁 ";
  horizontal-align: 0.5;
}

listview, inputbar, message {
  padding: 0.5em;  
  border-color: #950101;
  border:        2px;
  background-color: black/70%;

  columns: 3;
  lines:   3;
}
listview {
  border:       0px 2px 2px 2px;
}


element {
    border:  0;
    padding:      10px;
    font:         "FiraMono Nerd Font 8";
    orientation: vertical;
}
element-icon {
  size: 5em;
}

element  selected {
  border-color: #950101;
  border:       2px;
}

element-text, element-icon {
  font:             inherit; 
  horizontal-align: 0.5;
}

wrapper-mode-switcher {
    orientation: horizontal;

    expand:     false;
    spacing:    0;
    children: [ icon-ms-ic1, mode-switcher, icon-ms-ic2 ];
}
icon-ms-ic1 {
    filename: "go-previous";
    action: "kb-mode-previous";
}
icon-ms-ic2 {
    filename: "go-next";
    action: "kb-mode-next";
}
icon-ms-ic1,icon-ms-ic2 {
    size: 16;
    vertical-align: 0.8;
    expand:        false;
    border:       0px 0px 2px ;
    border-color: #950101;
}

mode-switcher {
    border:  0px;
    spacing: 0px;
    expand: true;
}
button {
    text-color: white;
    border:       0px 0px 0px 0px;
    border-color: #950101;
    background-image: linear-gradient(to bottom, #000000, #950101);
    horizontal-align: 0.5;
}
button selected.normal {
    text-color: white;
    margin: 0px;
    padding: 0px;

    border:       0px 0px 0px 0px ;
    border-color: #950101;
    background-image: linear-gradient(to bottom, #350101, #950101);
}

entry {
    placeholder: "Where to?";
    placeholder-color: darkgrey/90%;
    text-color: #FFFFFF;
  }
    padding: 0px;

    border:       3px 3px 0px ;
    border-color: #950101;
    border-radius:    3px 3px 0 0;
    background-image: linear-gradient(to bottom, #950101, black/70%);
}

entry {
    placeholder: "Oooh you wanna open TF2 ooooh...";
    placeholder-color: darkgrey/60%;
    text-color: #FFFFFFbb;
  }
