

* {
  normal-background: #00000099;
  normal-foreground: #FFFFFFbb;
  alternate-normal-background: #00000099;
  alternate-normal-foreground: #FFFFFFbb;
  selected-normal-background: #950101;
  selected-foreground: #FFFFFF;
}


window {
  padding: 1em;

  border-color: #950101;
  border:       3px;
  border-radius: 10px;

  width:  1024px; 
  height: 768px;

  background-color: #950101;

  background-image: url("/home/maplesyrup123/Pictures/random/red hex.jpg", width);
}

mainbox {
  spacing: 0px;
  children: [inputbar,wrapper-mode-switcher,listview];
}

element {
  background: transparent;
  children: [ element-icon, element-text ];
}
element,element-text,element-icon, button {
    cursor: pointer;
}

inputbar {
  margin: 0px 0px 0.5em 0em;
  spacing: 0.4em;
  children: [ button-iggy1, entry,overlay,case-indicator, button-iggy2];
}

button-iggy1, button-iggy2 {
  expand: false;
  content: "🍁";
  action: "kb-primary-paste";
  horizontal-align: 0.5;
}
button-iggy2 {
  action: "kb-screenshot";
}

listview, inputbar, message {
  padding: 0.5em;  
  border-color: #950101;
  border:        3px;
  border-radius: 10px;
  background-color: black/70%;

  columns: 6;
  lines:   5;
}
listview {
  border:       0px 3px 3px 3px;
  border-radius: 0px 0px 10px 10px;
}


element {
    border:  0;
    padding:      10px;
    font:         "FiraMono Nerd Font 8";
    orientation: vertical;
    background-color: #FF0000;
}
element-icon {
  size: 4em;
}

element  selected {
  border-color: #FF0000;
  border:       3px;
  border-radius: 10px;
  background-color: #FF0000;
}

element-text, element-icon {
  font:             inherit; 
  horizontal-align: 0.5;
}

wrapper-mode-switcher {
    orientation: horizontal;

    expand:     false;
    spacing:    0;
    children: [ icon-ms-ic1, mode-switcher, icon-ms-ic2 ];
}
icon-ms-ic1 {
    filename: "go-previous";
    action: "kb-mode-previous";
}
icon-ms-ic2 {
    filename: "go-next";
    action: "kb-mode-next";
}
icon-ms-ic1,icon-ms-ic2 {
    size: 16;
    vertical-align: 0.8;
    expand:        false;
    border:       0px 0px 3px ;
    border-color: #950101;
}

mode-switcher {
    border:  0px;
    spacing: 0px;
    expand: true;
}
button {
    text-color: white;
    border:       0px 0px 3px ;
    border-color: #950101;
    border-radius:    3px 3px 0 0;
    background-image: linear-gradient(to bottom, #00000088, black/70%);
    horizontal-align: 0.5;
}
button selected.normal {
    text-color: white;
    margin: 0px;
    padding: 0px;

    border:       3px 3px 0px ;
    border-color: #950101;
    border-radius:    3px 3px 0 0;
    background-image: linear-gradient(to bottom, #950101, black/70%);
}

entry {
    placeholder: "Oooh you wanna open TF2 ooooh...";
    placeholder-color: darkgrey/60%;
    text-color: #FFFFFFbb;
  }
